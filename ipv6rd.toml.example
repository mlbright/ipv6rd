# ipv6rd configuration. Copy to /etc/ipv6rd/ipv6rd.toml and edit.
#
# Every setting lives here; the only input from outside this file is the
# 1Password service-account token, read from the OP_SERVICE_ACCOUNT_TOKEN
# environment variable (the systemd unit supplies it via /etc/ipv6rd/ipv6rd.env).
# Durations use Go syntax: "300ms", "2s", "5m", "1h30m", "1.5h".

# --- Watcher tunables (all optional; defaults shown) ---

# Quiet period after an address event before recomputing the egress address.
debounce  = "2s"
# Reconciliation poll interval; backstop in case an address event is missed.
reconcile = "5m"
# Grant refresh: re-knock the current egress address this often even when it has
# not rotated, so a server-side grant that fwknopd expires (access_timeout in the
# fwknop-rs access stanza) is renewed before it lapses. Set it comfortably below
# that timeout. "0" disables it: knocks are then driven only by rotations, which
# never happen on a host with a stable address.
refresh   = "0s"
# Per-attempt timeout for a re-knock.
timeout   = "60s"
# Maximum knock attempts before giving up (bounded exponential backoff between
# attempts). Must be >= 1.
retries   = 3

# Path to the 1Password CLI. Optional: by default `op` is looked up on PATH at
# startup. It must not be group- or world-writable, and must be owned by root or
# by the user ipv6rd runs as.
# op_path = "/usr/bin/op"

# --- fwknop SPA (required) ---

[fwknop]
# SPA target: the host running fwknopd (fwknop-rs). It is looked up once at
# startup; that one IPv6 address is used both for kernel source-address selection
# and as the destination of every SPA packet, so the egress address we authorize
# is exactly the source the target sees. Must have an AAAA record (or be an IPv6
# literal); IPv4 is not supported. Restart ipv6rd if its address changes.
dest = "spa.example.com"

# UDP port fwknopd listens on for SPA packets.
port = 62159

# Access request: the protocol/port combinations to authorize, each sent as its
# own SPA packet. Each entry is "tcp/PORT" or "udp/PORT" (no ranges: an SPA
# message carries a single port). Optional; defaults to ["tcp/443"].
access = ["tcp/443", "tcp/22"]

# 1Password secret references (op://vault/item/field) for the base64-encoded
# encryption and HMAC keys, fetched once at startup with `op read`. The
# encryption key must decode to exactly 32 bytes and the HMAC key to 32-128
# bytes, different from it: generate them with `fwknop --key-gen`.
key_ref  = "op://fwknop/fwknop key/add more/text"
hmac_ref = "op://fwknop/fwknop hmac/add more/text"
